<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:EverLinkHost">
    <!-- Shared dark theme, used by every window (MainWindow, RelayConfigureWindow,
         InputDialog) via <ResourceDictionary.MergedDictionaries> - kept in one place so all
         windows stay visually consistent and a palette/style tweak only needs to happen
         once, rather than copy-pasted and drifting between window files. -->

    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ============================== PALETTE ==============================
             One small, consistent set of colors used throughout, rather than ad-hoc
             hex values scattered per-control - keeps the whole app reading as one
             coherent dark theme instead of a patchwork of individually-styled pieces. -->
        <SolidColorBrush x:Key="BgWindow" Color="#FF17181A"/>
        <SolidColorBrush x:Key="BgPanel" Color="#FF1E1F22"/>
        <SolidColorBrush x:Key="BgControl" Color="#FF2A2B2F"/>
        <SolidColorBrush x:Key="BgControlHover" Color="#FF34363B"/>
        <SolidColorBrush x:Key="BgControlPressed" Color="#FF3D3F45"/>
        <SolidColorBrush x:Key="BgSelected" Color="#FF2F4A3E"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#FF35373C"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#FF4C9E76"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFE2E4E8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9DA4"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF6B6E75"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFD9A441"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFD9534F"/>

        <!-- ============================== WINDOW CHROME ============================== -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{StaticResource BgPanel}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Margin="0,8,0,0">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter Grid.Row="0" Content="{TemplateBinding Header}"
                                                       ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                       TextElement.FontSize="11" TextElement.FontWeight="SemiBold"
                                                       TextElement.Foreground="{StaticResource TextSecondary}"
                                                       Margin="8,6,8,4"/>
                                    <ContentPresenter Grid.Row="1" Margin="4,0,4,4"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== BUTTONS ==============================
             Restrained: a flat fill, subtle border, gentle hover/press states. No
             gradients or glow - matches the "modern utility, not gamer RGB" brief. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgControl}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== LISTBOX ============================== -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="0,1"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControl}"/>
                            </Trigger>
                            <!-- Selected state: a clear but subtle tint + left accent bar,
                                 not a bright highlight block - matches the brief's "clear
                                 but subtle selected state" requirement. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSelected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== LISTVIEW / GRIDVIEW ============================== -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource BorderSubtle}">
                            <GridViewRowPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControl}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== TEXTBOX ============================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgControl}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== CHECKBOX (used elsewhere in the app) ============================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- ComboBox needs a full custom ControlTemplate, not plain property setters -
             WPF's default ComboBox chrome (an internal ToggleButton + Popup) doesn't
             reliably repaint from simple Background/Foreground setters alone, which is
             why an earlier attempt at this left the dropdown showing default white/black. -->
        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{StaticResource BgControl}" BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextSecondary}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgControl}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <!-- ToggleButton spans the full width (column span 2) and sits
                                 underneath everything else - it's what actually opens the
                                 dropdown on click. The bug this fixes: PART_EditableTextBox
                                 used to also span the full width and sat ON TOP of this
                                 button with no gap, so every click - including on the
                                 arrow - went to the TextBox instead of ever reaching the
                                 ToggleButton, and the dropdown could never open. Now the
                                 TextBox only occupies column 0 (the text area), leaving
                                 column 1 (the arrow) exclusively hit-testable by the
                                 ToggleButton beneath it. -->
                            <ToggleButton x:Name="ToggleButton" Grid.Column="0" Grid.ColumnSpan="2"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <!-- Non-editable display (default): shows the selected item via
                                 ContentPresenter. Hidden when IsEditable is true, in favor
                                 of the TextBox below - both existing side by side and only
                                 one visible at a time is the standard WPF pattern for this. -->
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- Editable mode: a real TextBox the user can type into freely
                                 (e.g. entering a new preset name), while the dropdown below
                                 still offers existing values to pick from. WPF's ComboBox
                                 wiring expects this exact part name (PART_EditableTextBox)
                                 to hook up Text<->ComboBox.Text automatically. Confined to
                                 column 0 only - see the ToggleButton comment above for why
                                 that matters. -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Style="{x:Null}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     Margin="{TemplateBinding Padding}"
                                     VerticalContentAlignment="Center"
                                     Visibility="Hidden" Focusable="True"/>
                            <Popup x:Name="Popup" Grid.Column="0" Grid.ColumnSpan="2" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource BgControl}" BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240" Margin="0,2,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource BgControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EverLinkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#FF3A3B40" BorderBrush="#FF4B4D53"
                                BorderThickness="1" CornerRadius="3">
                            <!-- Grip lines: a fixed small number of thin, full-width lines
                                 stacked with even spacing via a centered StackPanel, rather
                                 than a UniformGrid with a fixed row count (which stretched
                                 lines far apart on a tall thumb, and didn't leave room for
                                 all of them on a short one). Centering the StackPanel
                                 vertically means it simply won't render rows that don't
                                 fit rather than clipping them, and a small fixed count of
                                 thin lines keeps consistent visual weight regardless of
                                 the thumb's actual height. -->
                            <StackPanel VerticalAlignment="Center" Margin="5,0">
                                <Rectangle Height="1" Fill="#FF868A92" Margin="0,1.5"/>
                                <Rectangle Height="1" Fill="#FF868A92" Margin="0,1.5"/>
                                <Rectangle Height="1" Fill="#FF868A92" Margin="0,1.5"/>
                                <Rectangle Height="1" Fill="#FF868A92" Margin="0,1.5"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF45474D"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#FF55585F"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF4B4E54"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#FF5D6067"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="#FF202124"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent"
                                                  BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent"
                                                  BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource EverLinkScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
