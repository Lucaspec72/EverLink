<Window x:Class="EverLinkHost.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Device" Height="160" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}">
    <!-- Pulls in the same shared dark theme every other window in the app uses (Button,
         TextBox, and window Background are all styled globally by TargetType in
         Theme.xaml) - this window was missing this merge entirely, which is why it was
         rendering with plain default WPF white/black chrome instead of matching the rest
         of the app. -->
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock x:Name="PromptText" Text="Enter a name:" Margin="0,0,0,8"
                   Foreground="{StaticResource TextPrimary}"/>
        <TextBox x:Name="InputTextBox" Margin="0,0,0,12" KeyDown="InputTextBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reset to Default" Width="110" Margin="0,0,8,0" Click="ResetButton_Click"/>
            <Button Content="Cancel" Width="70" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="OK" Width="70" Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
