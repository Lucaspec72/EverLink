<UserControl x:Class="EverLinkHost.GamepadPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="230">
    <!--
        Draws one gamepad state visually - buttons light up, triggers fill, sticks move.
        Used twice in RelayConfigureWindow: once fed the controller's raw state ("Raw
        Input"), once fed RemapProfile.Apply's output ("Remapped Output") - see
        UpdateState's doc comment for why one control instance can serve both without any
        "which mode am I in" flag. Originally this whole Canvas lived directly in
        RelayConfigureWindow.xaml with element names wired straight into that window's
        code-behind (UpdatePreviewVisuals) - pulled out into its own UserControl
        specifically so a second, independent copy could exist side by side for the
        remapped-output preview without duplicating ~40 lines of Canvas markup and every
        SetPressed/PositionStick call by hand a second time with renamed elements.

        Coordinates below are unchanged from the original single-preview Canvas - same
        238x230 layout, just now addressed by THIS control's own x:Name scope rather than
        the window's.
    -->
    <Canvas x:Name="RootCanvas" Width="238" Height="230" Background="#FF1E1E1E">
        <TextBlock Text="LT" Canvas.Left="15" Canvas.Top="8" Foreground="White" FontSize="10" IsHitTestVisible="False"/>
        <Rectangle x:Name="TriggerLFill" Width="0" Height="10" Canvas.Left="35" Canvas.Top="8" Fill="#FF4CAF50"/>
        <Rectangle Width="55" Height="10" Canvas.Left="35" Canvas.Top="8" Stroke="White" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False"/>
        <TextBlock Text="RT" Canvas.Left="150" Canvas.Top="8" Foreground="White" FontSize="10" IsHitTestVisible="False"/>
        <Rectangle x:Name="TriggerRFill" Width="0" Height="10" Canvas.Left="170" Canvas.Top="8" Fill="#FF4CAF50"/>
        <Rectangle Width="55" Height="10" Canvas.Left="170" Canvas.Top="8" Stroke="White" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False"/>

        <Rectangle x:Name="ShoulderL" Width="55" Height="16" Canvas.Left="15" Canvas.Top="26" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="LB" Canvas.Left="32" Canvas.Top="27" Foreground="White" FontSize="10" IsHitTestVisible="False"/>
        <Rectangle x:Name="ShoulderR" Width="55" Height="16" Canvas.Left="170" Canvas.Top="26" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="RB" Canvas.Left="187" Canvas.Top="27" Foreground="White" FontSize="10" IsHitTestVisible="False"/>

        <Rectangle x:Name="DpadUp" Width="18" Height="18" Canvas.Left="40" Canvas.Top="55" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <Rectangle x:Name="DpadDown" Width="18" Height="18" Canvas.Left="40" Canvas.Top="93" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <Rectangle x:Name="DpadLeft" Width="18" Height="18" Canvas.Left="21" Canvas.Top="74" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <Rectangle x:Name="DpadRight" Width="18" Height="18" Canvas.Left="59" Canvas.Top="74" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>

        <Ellipse x:Name="BtnY" Width="28" Height="28" Canvas.Left="170" Canvas.Top="50" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="Y" Canvas.Left="179" Canvas.Top="57" Foreground="White" IsHitTestVisible="False"/>
        <Ellipse x:Name="BtnX" Width="28" Height="28" Canvas.Left="140" Canvas.Top="78" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="X" Canvas.Left="149" Canvas.Top="85" Foreground="White" IsHitTestVisible="False"/>
        <Ellipse x:Name="BtnB" Width="28" Height="28" Canvas.Left="200" Canvas.Top="78" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="B" Canvas.Left="209" Canvas.Top="85" Foreground="White" IsHitTestVisible="False"/>
        <Ellipse x:Name="BtnA" Width="28" Height="28" Canvas.Left="170" Canvas.Top="106" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="A" Canvas.Left="179" Canvas.Top="113" Foreground="White" IsHitTestVisible="False"/>

        <Ellipse x:Name="BtnBack" Width="18" Height="18" Canvas.Left="80" Canvas.Top="140" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="Select" Canvas.Left="68" Canvas.Top="159" Foreground="White" FontSize="9" IsHitTestVisible="False"/>
        <Ellipse x:Name="BtnGuide" Width="22" Height="22" Canvas.Left="108" Canvas.Top="138" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="Guide" Canvas.Left="96" Canvas.Top="163" Foreground="White" FontSize="9" IsHitTestVisible="False"/>
        <Ellipse x:Name="BtnStart" Width="18" Height="18" Canvas.Left="140" Canvas.Top="140" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <TextBlock Text="Start" Canvas.Left="132" Canvas.Top="159" Foreground="White" FontSize="9" IsHitTestVisible="False"/>

        <Ellipse Width="60" Height="60" Canvas.Left="20" Canvas.Top="170" Stroke="Gray" StrokeThickness="1" Fill="#FF2A2A2A"/>
        <Ellipse x:Name="StickLDot" Width="20" Height="20" Canvas.Left="40" Canvas.Top="190" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
        <Ellipse Width="60" Height="60" Canvas.Left="160" Canvas.Top="170" Stroke="Gray" StrokeThickness="1" Fill="#FF2A2A2A"/>
        <Ellipse x:Name="StickRDot" Width="20" Height="20" Canvas.Left="180" Canvas.Top="190" Fill="#FF3A3A3A" Stroke="White" StrokeThickness="1"/>
    </Canvas>
</UserControl>
