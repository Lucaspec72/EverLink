<Window x:Class="EverLinkHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EverLink Host" Height="560" Width="640" MinHeight="360" MinWidth="480"
        Background="#FF17181A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EverLink Relays: the only top-level list now. Every detected Relay is shown
             here as soon as it's found - there's no separate "pair" step, no Available/
             Used split. A Relay's connection to the console starts the moment its serial
             link opens; controller assignment (via the Configure window) is a later,
             optional attribute of an already-existing Relay, not a precondition for it to
             appear here. See RelayManager/RelayConnection for the underlying model. -->
        <GroupBox Grid.Row="0" Header="EverLink Relays">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Rescan" HorizontalAlignment="Right" Width="90" Margin="4" Click="RescanRelaysButton_Click"/>
                <Grid>
                    <ListBox x:Name="RelayListBox" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Relay name (large) + assigned controller (small,
                                         underneath, with an activity dot to its left) -
                                         same visual pattern the old Used relay list used,
                                         plus the activity indicator. -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceLabel}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ControllerIsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ControllerLabel}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Connection status only now - the old second line
                                         (USB Output: Supported/Unsupported) moved into the
                                         compatibility-issues popup (see the warning button
                                         below), alongside any other feature gaps a given
                                         Relay has, rather than always occupying its own
                                         line here even when there's nothing wrong to
                                         report. VerticalAlignment/HorizontalAlignment
                                         Center (rather than the old Right-aligned stack)
                                         since this is now a single line, not a paired
                                         readout that needed right-edge alignment to line
                                         up with its partner line underneath. -->
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionStatusLabel}" FontSize="10"
                                               Foreground="{Binding ConnectionStatusColor}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Compatibility-issue warning button: only takes up
                                         space/appears when this Relay actually has an
                                         issue (see RelayRow.HasCompatibilityIssue) - a
                                         Relay with nothing wrong shows no button at all
                                         here, rather than a disabled/greyed one, so the
                                         row doesn't visually change shape for the common
                                         case of everything being fine. Sits left of
                                         Configure, right of the connection status text. -->
                                    <Button Grid.Column="2" Content="&#x26A0;" FontSize="12" Padding="6,2" VerticalAlignment="Center"
                                            Margin="0,0,6,0" ToolTip="Compatibility issues"
                                            Visibility="{Binding HasCompatibilityIssue, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="OpenIssuesButton_Click"/>

                                    <Button Grid.Column="3" Content="Configure" FontSize="10" Padding="8,4" VerticalAlignment="Center"
                                            Click="OpenConfigureButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename..." Click="RenameDevice_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="RelayEmptyText" Text="(none found - plug in an EverLink Relay and rescan)"
                               Margin="8" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontStyle="Italic"
                               IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
